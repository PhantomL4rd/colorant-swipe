{
  "name": "colorant-swipe",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "bun install --frozen-lockfile && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome lint .",
    "format:fix": "biome format --write .",
    "fix": "biome check --write .",
    "test:engine": "tsx src/lib/engine.check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@lucide/svelte": "^0.561.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "mode-watcher": "^1.1.0",
    "sveltekit-i18n": "^2.4.2",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "cookie": "^1.0.2"
  }
}
